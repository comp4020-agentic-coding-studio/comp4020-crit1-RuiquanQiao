{
  "name": "comp4020-static-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "prepare:pages": "node scripts/prepare-pages.ts",
    "dev": "pnpm prepare:pages && vite",
    "build": "pnpm prepare:pages && vite build",
    "preview": "vite preview",
    "news:refresh": "node scripts/refresh-news.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && oxlint --ignore-path .gitignore && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && vitest run",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
